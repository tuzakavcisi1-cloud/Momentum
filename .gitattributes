# Satır sonlarını repo'da LF'e normalize et (CI Linux/macOS ile uyum)
* text=auto eol=lf

# Windows'a özgü betikler CRLF kalsın
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Unix betikleri LF
*.sh    text eol=lf

# İkili dosyalar
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.pfx   binary
*.p12   binary
*.snk   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
