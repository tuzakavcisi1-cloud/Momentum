<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR 0001 K-A1: Infrastructure -> Application only. slice-2b1: EF Core + Npgsql persistence. -->

  <ItemGroup>
    <!-- EF Core pinned to 9.0.1 to match Npgsql.EntityFrameworkCore.PostgreSQL 9.0.4's dependency
         (avoids the Relational 9.0.1 vs 9.0.18 assembly conflict). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- slice-2b2 D2: OutboxDispatcher : BackgroundService. Plain SDK project (not Web) -> the Generic
         Host abstractions are not part of the implicit framework here and need an explicit reference.
         MIT; does NOT pull in SignalR/AspNetCore (D9-b's "Infrastructure not SignalR-dependent" stays true). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Momentum.Application\Momentum.Application.csproj" />
  </ItemGroup>

</Project>
