<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ADR 0001 K-A1: Api -> Application + Infrastructure (composition root / wiring only). -->

  <ItemGroup>
    <!-- K-D1: built-in OpenAPI JSON generator (pinned to the 10.0.x shared framework). -->
    <!-- CVE PINI (kirmizi cizgi 3): AspNetCore.OpenApi 10.0.10 transitif olarak
         Microsoft.OpenApi 2.0.0 getiriyor; o surumde GHSA-v5pm-xwqc-g5wc (High, CVSS 7.5,
         uncontrolled recursion) var ve NuGetAudit build i KIRIYOR. Ilk yamali surum 2.7.5;
         burada 2.11.0 pinlenir. AspNetCore.OpenApi guvenli bir transitif surume gectiginde
         bu satir SILINIR. Olcum: dotnet nuget why Momentum.sln Microsoft.OpenApi. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- K-D1: Scalar API reference UI (no built-in Swagger UI in .NET 9/10). -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.15" />
    <!-- K-D4: URL-segment API versioning (/v1). -->
    <PackageReference Include="Asp.Versioning.Http" Version="8.1.1" />
    <!-- K-G3: structured logging + request logging + correlation-id. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Momentum.Application\Momentum.Application.csproj" />
    <ProjectReference Include="..\Momentum.Infrastructure\Momentum.Infrastructure.csproj" />
  </ItemGroup>

</Project>
