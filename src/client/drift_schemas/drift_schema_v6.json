          "sql": "CREATE TABLE IF NOT EXISTS \"ayarlar\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"client_id\" TEXT NOT NULL, \"son_wall\" INTEGER NOT NULL DEFAULT 0, \"son_counter\" INTEGER NOT NULL DEFAULT 0, \"next_cursor_json\" TEXT NULL, \"dev_user_id\" TEXT NOT NULL, \"imlec_sahibi\" TEXT NULL, PRIMARY KEY (\"id\"));"
