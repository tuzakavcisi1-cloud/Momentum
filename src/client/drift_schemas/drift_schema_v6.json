    {
      "name": "gorevler",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"gorevler\" (\"id\" TEXT NOT NULL, \"baslik\" TEXT NOT NULL, \"tamamlandi\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tamamlandi\" IN (0, 1)), \"olusturuldu\" INTEGER NOT NULL, \"guncellendi\" INTEGER NOT NULL, \"senkron_durumu\" TEXT NOT NULL DEFAULT 'yerel' CHECK(\"senkron_durumu\" IN ('yerel', 'kuyrukta', 'senkronize', 'cakisma', 'cevrimdisi')), \"silindi\" INTEGER NOT NULL DEFAULT 0 CHECK (\"silindi\" IN (0, 1)), \"oncelik\" INTEGER NULL, \"son_tarih\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "senkron_kuyrugu",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"senkron_kuyrugu\" (\"op_id\" TEXT NOT NULL, \"client_id\" TEXT NOT NULL, \"entity_type\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"govde_json\" TEXT NOT NULL, \"hlc_wall_ms\" INTEGER NOT NULL, \"hlc_counter\" INTEGER NOT NULL, \"durum\" TEXT NOT NULL DEFAULT 'bekliyor' CHECK(\"durum\" IN ('bekliyor', 'gonderildi', 'zehirli')), \"deneme_sayisi\" INTEGER NOT NULL DEFAULT 0, \"son_hata_kodu\" TEXT NULL, \"olusturuldu\" INTEGER NOT NULL, PRIMARY KEY (\"op_id\"));"
        }
      ]
    },
    {
      "name": "ayarlar",
      "sql": [
        {
